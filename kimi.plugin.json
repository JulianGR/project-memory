{
  "name": "project-memory",
  "version": "1.0.0",
  "description": "Repo-local AGENTS.md memory with one turn-end review hook for Kimi Code CLI.",
  "author": {
    "name": "JulianGR"
  },
  "homepage": "https://github.com/JulianGR/project-memory",
  "license": "MIT",
  "keywords": ["memory", "handoff", "project-context"],
  "skills": "./skills/",
  "interface": {
    "displayName": "Project Memory",
    "shortDescription": "Keep durable project context current.",
    "longDescription": "Reviews durable project context at turn end and maintains AGENTS.md without routine reminders.",
    "developerName": "JulianGR",
    "websiteURL": "https://github.com/JulianGR/project-memory"
  },
  "hooks": [
    {
      "event": "Stop",
      "command": "node ./bin/project-memory.mjs stop --host kimi",
      "timeout": 5
    }
  ]
}
