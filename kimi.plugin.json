{
  "name": "project-memory",
  "version": "1.0.0",
  "description": "Repo-local AGENTS.md memory with every-prompt reminders for Kimi Code CLI.",
  "author": {
    "name": "JulianGR"
  },
  "homepage": "https://github.com/JulianGR/project-memory",
  "license": "MIT",
  "keywords": ["memory", "handoff", "project-context"],
  "skills": "./skills/",
  "interface": {
    "displayName": "Project Memory",
    "shortDescription": "Keep durable project context current.",
    "longDescription": "Initializes AGENTS.md project memory and reminds Kimi to review durable context every turn.",
    "developerName": "JulianGR",
    "websiteURL": "https://github.com/JulianGR/project-memory"
  },
  "hooks": [
    {
      "event": "SessionStart",
      "command": "node ./bin/project-memory.mjs session-start --host kimi",
      "timeout": 5
    },
    {
      "event": "UserPromptSubmit",
      "command": "node ./bin/project-memory.mjs prompt --host kimi",
      "timeout": 5
    }
  ]
}
